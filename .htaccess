<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Force HTTPS for API requests using HTTP 308 (RFC 7538: preserves POST method & payload)
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteCond %{HTTPS} !on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://www.ridemycars.com/$1 [L,R=308]

    # 1b. Force HTTPS for Web requests
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{HTTPS} !on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://www.ridemycars.com/$1 [L,R=301]

    # 2. Force www.ridemycars.com Canonical Host (exempt /auth/, /api/ and /storage/ so POST requests from Apple/mobile apps are not redirected)
    RewriteCond %{REQUEST_URI} !^/auth/
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/storage/
    RewriteCond %{HTTP_HOST} ^ridemycars\.com$ [NC]
    RewriteRule ^(.*)$ https://www.ridemycars.com/$1 [L,R=301,QSA]

    # 3. Strip direct access to internal laravel_web/public/ directory
    RewriteCond %{THE_REQUEST} \s/+laravel_web/public/(\S*) [NC]
    RewriteRule ^ /%1 [L,R=301]

    # 4. Remove trailing slashes for non-directories (exempt /api/ to prevent 301 breaking mobile client requests)
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # 5. Route requests to Laravel public front controller
    RewriteCond %{REQUEST_URI} !^/laravel_web/public/
    RewriteRule ^(.*)$ laravel_web/public/$1 [L]
</IfModule>
